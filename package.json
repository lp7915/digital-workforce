{
  "name": "digital-workforce",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --experimental-strip-types src/workforce/main.ts",
    "bot": "node --experimental-strip-types src/workforce/bot-main.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:workforce": "node --experimental-strip-types --test tests/workforce*.test.ts",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build-workforce.mjs",
    "format:check": "prettier --check 'src/workforce/*.ts' 'tests/workforce*.test.ts' 'public/*' package.json scripts/build-workforce.mjs"
  },
  "dependencies": {
    "@larksuite/channel": "0.4.1",
    "@larksuiteoapi/node-sdk": "^1.56.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "prettier": "https://registry.npmjs.org/prettier/-/prettier-3.8.3.tgz"
  },
  "engines": {
    "node": ">=22.13"
  }
}
